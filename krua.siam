{ "info": { "version": "1.0.0", "name": "Krua Siam", "logo": "https://i.postimg.cc/Bv4RfzhS/krua-siam.png", "night_logo": "https://i.postimg.cc/Bv4RfzhS/krua-siam.png", "page_link": "" }, "rstsetting": { "themeColor": "orange", "photoRatio": "4:3", "showAddToCartButton": true, "showIngredients": true, "showDescription": true, "showName": true, "showPrice": true, "showMyLanguageDescription": true }, "slide": [], "ad_banner": [], "special": { "title": "Recommendation", "id": "Soup", "day": "all", "end": "2026-03-30" }, "categories": [ { "name": "All Food", "id": "food_menu", "add_on": "", "food": true, "open_in": "00:00-23:59", "icon_id": "https://i.postimg.cc/g2pQHW9c/quesadilla.gif" }, { "name": "Rice", "id": "Rice", "add_on": "", "food": true, "open_in": "00:00-23:59", "icon_id": "" }, { "name": "Soup", "id": "Soup", "add_on": "", "food": true, "open_in": "00:00-23:59", "icon_id": "" }, { "name": "Noodle", "id": "Noodle", "add_on": "", "food": true, "open_in": "00:00-23:59", "icon_id": "" }, { "name": "All Drinks", "id": "drink_menu", "add_on": "", "food": false, "open_in": "00:00-23:59", "icon_id": "https://i.postimg.cc/VvbB3dtd/cold-drink.gif" }, { "name": "Soft Drink", "id": "soft_drinks", "add_on": "", "food": false, "open_in": "00:00-23:59", "icon_id": "https://i.postimg.cc/gJk6NJkc/beer-can.gif" }, { "name": "Beers", "id": "Beer", "food": false, "open_in": "00:00-23:59", "icon_id": "https://i.postimg.cc/gJk6NJkc/beer-can.gif" }, { "name": "Fruit Juice", "id": "juice", "add_on": "", "food": false, "open_in": "00:00-23:59", "icon_id": "https://i.postimg.cc/VvbB3dtd/cold-drink.gif" }, { "name": "Fruit Smoothie", "id": "smoothie", "add_on": "", "food": false, "open_in": "00:00-23:59", "icon_id": "https://i.postimg.cc/VvbB3dtd/cold-drink.gif" } ], "lists": [ { "title": "Thai Chicken Rice", "description": [ "Tender chicken rice with chicken cooked with chicken broth. Comes with our signature fragrant chicken rice, cucumber and light soup.", "ข้าวมันไก่เนื้อนุ่มต้มในน้ำซุปไก่รสกลมกล่อม เสิร์ฟพร้อมข้าวมันหอมกรุ่นสูตรพิเศษ แตงกวา และน้ำซุปร้อนๆ ค่ะ", "ကြက်သားပြုတ်ရည်ဖြင့်ချက်ထားသော နူးညံ့သည့်ကြက်ဆีထမင်း။ အမွှေးနံ့သာကြက်ဆีထမင်း၊ သခွားသီးနှင့် ဟင်းချိုတို့ပါဝင်ပါသည်။", "Zartes Hähnchen mit in Hühnerbrühe gekochtem Reis. Serviert mit unserem duftenden Signatur-Reis, Gurke und einer leichten Suppe.", "鲜嫩的鸡肉配上用鸡汤煮制的香米饭。附赠招牌香鸡饭、黄瓜和清汤。", "Нежное куриное мясо с рисом на курином бульоне. Подается с фирменным ароматным рисом, огурцом и легким супом.", "אורז עוף רך המבושל בציר עוף. מוגש עם אורז העוף הריחני המיוחד שלנו, מלפפון ומרק צח.", "Tierno arroz con pollo cocinado en caldo de pollo. Viene con nuestro arroz aromático exclusivo, pepino y una sopa ligera.", "치킨 육수로 조리한 부드러운 치킨 라이스입니다. 시그니처 향긋한 치킨 라이스와 오이, 맑은 국물이 함께 제공됩니다.", "鶏出汁で炊き上げた柔らかい鶏肉のチキンライス。自慢の香り高いチキンライス、きゅうり、スープがセットになっています。", "Riz au poulet tendre cuit dans un bouillon de poulet. Servi avec notre riz parfumé signature, du concombre et une soupe légère.", "Tenero riso al pollo cucinato con brodo di pollo. Servito con il nostro esclusivo riso fragrante, cetrioli e una zuppa leggera.", "Frango tenro com arroz cozido em caldo de galinha. Acompanha nosso arroz de frango aromático exclusivo, pepino e sopa leve.", "Cơm gà mềm ngon được nấu cùng nước dùng gà. Đi kèm với cơm gà thơm đặc trưng, dưa leo và canh thanh đạm.", "चिकन शोरबा में पका हुआ कोमल चिकन चावल। हमारे सिग्नेचर सुगंधित चिकन चावल, ककड़ी और हल्के सूप के साथ आता है।", "أرز الدجاج الطري المطبوخ بمرق الدجاج. يقدم مع أرز الدجاج العطري المميز، الخيار وحساء خفيف." ], "price": 80, "category": "food_menu,Rice", "type": "meat", "add_on": "", "food": true, "ingredients": [ "Poached chicken", "Jasmine rice", "Garlic", "Ginger", "Pandan leaf", "Chicken broth", "Cucumber", "Coriander", "Soybean paste sauce" ] }, { "title": "Thai Crispy Chicken Rice", "description": [ "Crispy fried chicken served with fragrant jasmine rice, cucumber, and dipping sauce.", "ไก่ทอดกรอบนอกนุ่มใน เสิร์ฟพร้อมข้าวหอมมะลิหุงสุกหอมๆ แตงกวา และน้ำจิ้มสูตรเด็ดค่ะ", "မွှေးပျံ့သော စံပယ်ထမင်း၊ သခွားသီးနှင့် အချဉ်ရည်တို့ဖြင့် တည်ခင်းထားသော ကြက်သားကြော်ကြွပ်ကြွပ်။", "Knuspriges Brathähnchen serviert mit duftendem Jasminreis, Gurke und Dip-Sauce.", "香脆炸鸡配香喷喷的茉莉香米饭、黄瓜和蘸酱。", "Хрустящая жареная курица, подается с ароматным рисом жасмин, огурцом и соусом для макания.", "עוף מטוגן קריספי מוגש עם אורז יסמין ריחני, מלפפון ורוטב טבילה.", "Pollo frito crujiente servido con arroz jazmín fragante, pepino y salsa.", "바삭한 프라이드 치킨이 향긋한 자스민 라이스, 오이, 소스와 함께 제공됩니다.", "カリカリのフライドチキンを、香り高いジャスミンライス、きゅうり、タレと一緒にどうぞ。", "Poulet frit croustillant servi avec du riz jasmin parfumé, du concombre et une sauce.", "Pollo fritto croccante servito con riso jasmine fragrante, cetrioli e salsa d'accompagnamento.", "Frango frito crocante servido com arroz jasmim aromático, pepino e molho.", "Gà chiên giòn rụm ăn kèm cơm hương lài thơm mát, dưa leo và nước chấm.", "खस्ता फ्राइड चिकन सुगंधित चमेली चावल, ककड़ी और डिपिंग सॉस के साथ परोसा जाता है।", "دجاج مقلي مقرمش يقدم مع أرز الياسمين العطري، الخيار وصلصة الغمس." ], "price": 80, "category": "food_menu,Rice", "type": "meat", "add_on": "", "food": true, "ingredients": [ "Deep-fried battered chicken", "Jasmine rice", "Garlic", "Ginger", "Cucumber", "Sweet chili sauce" ] }, { "title": "Mixed Chicken Rice (Boiled & Crispy)", "description": [ "Combination of tender steamed chicken and crispy fried chicken served with fragrant jasmine rice, cucumber, and a side of light soup.", "อร่อยสองสไตล์ด้วยไก่ต้มเนื้อนุ่มและไก่ทอดกรอบ เสิร์ฟพร้อมข้าวหอมมะลิ แตงกวา และน้ำซุปใสร้อนๆ ค่ะ", "နူးညံ့သောကြက်သားပြုတ်နှင့် ကြက်သားကြော်ကြွပ်ကြွပ်တို့ကို စံပယ်ထမင်း၊ သခွားသီး၊ ဟင်းချိုတို့နှင့် တွဲဖက်ထားသည်။", "Kombination aus zartem gedämpftem Hähnchen und knusprigem Brathähnchen, serviert mit Jasminreis, Gurke und Suppe.", "鲜嫩白切鸡与香脆炸鸡的双拼组合，配以茉莉香米、黄瓜和清汤。", "Сочетание нежной паровой курицы и хрустящей жареной курицы, подается с рисом жасмин, огурцом и супом.", "שילוב של עוף מאודה רך ועוף מטוגן קריספי מוגש עם אורז יסמין ריחני, מלפפון ומרק צח.", "Combinación de tierno pollo al vapor y pollo frito crujiente servido con arroz jazmín, pepino y sopa.", "부드러운 찐 치킨과 바삭한 프라이드 치킨의 조합으로 자스민 라이스, 오이, 맑은 국물이 함께 제공됩니다.", "しっとり蒸し鶏とカリカリ唐揚げのコンビネーション。ジャスミンライス、きゅうり、スープ付き。", "Mélange de poulet à la vapeur tendre et de poulet frit croustillant, servi avec riz jasmin, concombre et soupe.", "Combinazione di tenero pollo al vapore e pollo fritto croccante servita con riso jasmine, cetrioli e zuppa.", "Combinação de frango cozido no vapor e frango frito crocante servido com arroz jasmim, pepino e sopa.", "Sự kết hợp giữa gà luộc mềm và gà chiên giòn, ăn kèm cơm hương lài, dưa leo và canh.", "कोमल स्टीम्드 चिकन और खस्ता फ्राइड चिकन का संयोजन सुगंधित चमेली चावल, ककड़ी और सूप के साथ।", "مزيج من الدجاج المطهو على البخار والدجاج المقلي المقرمش يقدم مع أرز الياسمين، الخيار وحساء جانبي." ], "price": 100, "category": "food_menu,Rice", "type": "meat", "add_on": "", "food": true, "ingredients": [ "Poached chicken", "Deep-fried battered chicken", "Jasmine rice", "Garlic", "Ginger", "Cucumber", "Chicken broth", "Dipping sauces" ] }, { "title": "Singapore Style Chicken Rice", "description": [ "Tender steamed chicken with fragrant rice cooked in chicken broth. Comes with our special ginger sauce, light soup, cucumber and a side of light chicken soup.", "ข้าวมันไก่สไตล์สิงคโปร์ ไก่ต้มเนื้อนุ่มพร้อมข้าวหอมมะลิหุงน้ำซุป เสิร์ฟพร้อมน้ำจิ้มขิงสูตรพิเศษและน้ำซุปใสค่ะ", "ကြက်သားပြုတ်ရည်ဖြင့်ချက်ထားသော မွှေးပျံ့သည့်ထမင်းနှင့် နူးညံ့သောကြက်သားပြုတ်။ ချင်းအချဉ်ရည်၊ ဟင်းချိုတို့ပါဝင်သည်။", "Gedämpftes Hähnchen nach Singapur-Art mit in Brühe gekochtem Reis. Serviert mit spezieller Ingwer-Sauce, Gurke und Suppe.", "新加坡风味海南鸡饭。鲜嫩蒸鸡配鸡汤香米饭，附带特制姜酱、清汤和黄瓜。", "Курица по-сингапурски: нежное паровое мясо с ароматным рисом. Подается со специальным имбирным соусом, огурцом и бульоном.", "עוף בנוסח סינגפור: עוף מאודה רך עם אורז ריחני המבושל בציר. מוגש עם רוטב ג'ינג'ר מיוחד, מלפפון ומרק.", "Pollo al estilo Singapur: tierno pollo al vapor con arroz aromático cocinado en caldo. Incluye salsa de jengibre especial, pepino y sopa.", "싱가포르 스타일 치킨 라이스입니다. 육수로 지은 향긋한 밥과 부드러운 찐 치킨, 특제 생강 소스, 오이, 국물이 제공됩니다.", "シンガポールスタイルのチキンライス。鶏出汁のご飯と蒸し鶏、特製ジンジャーソース、きゅうり、スープのセット。", "Riz au poulet de style Singapour. Poulet à la vapeur avec riz parfumé, servi avec sauce au gingembre spéciale, concombre et soupe.", "Riso al pollo in stile Singapore. Tenero pollo al vapore con riso fragrante, servito con salsa speciale allo zenzero, cetrioli e zuppa.", "Arroz de frango estilo Singapura. Frango ao vapor com arroz aromático, servido com molho de gengibre especial, pepino e sopa.", "Cơm gà kiểu Singapore. Gà hấp mềm cùng cơm thơm nấu nước dùng gà, ăn kèm sốt gừng đặc biệt, dưa leo và canh.", "सिंगापुर शैली का चिकन चावल। सुगंधित चावल और कोमल स्टीम्드 चिकन, विशेष अदरक सॉस, ककड़ी और सूप के साथ।", "أرز الدجاج على طريقة سنغافورة. دجاج مطهو على البخار مع أرز عطري مطبوخ بالمرق، يقدم مع صلصة الزنجبيل الخاصة وحساء." ], "price": 100, "category": "food_menu,Rice", "type": "meat", "add_on": "", "food": true, "ingredients": [ "Poached chicken", "Jasmine rice", "Ginger", "Garlic", "Pandan leaf", "Sesame oil", "Light soy sauce", "Cucumber", "Chili-ginger sauce" ] }, { "title": "Clear Noodle Soup (Chicken/Pork/Tofu)", "description": [ "Noodles in clear broth with vegetables, crispy wonton, choice of chicken, pork or tofu, and meatballs.", "ก๋วยเตี๋ยวน้ำใสรสกลมกล่อม ใส่ผัก เกี๊ยวกรอบ ลูกชิ้น และเลือกโปรตีนได้ตามใจชอบ (ไก่/หมู/เต้าหู้) ค่ะ", "ဟင်းသီးဟင်းရွက်၊ ဝမ်တွန်းကြော်၊ အသားလုံးတို့ပါဝင်သော ခေါက်ဆွဲပြုတ်ရည်ကြည်။ ကြက်သား၊ ဝက်သား သို့မဟုတ် တိုဟူး ရွေးချယ်နိုင်သည်။", "Nudeln in klarer Brühe mit Gemüse, knusprigem Wonton, Fleischbällchen und wahlweise Hähnchen, Schwein oder Tofu.", "清汤面配蔬菜、脆皮云吞、肉丸，可选鸡肉、猪肉或豆腐。", "Лапша в прозрачном бульоне с овощами, хрустящим вонтоном, фрикадельками и выбором курицы, свинины или тофу.", "נודלס במרק צח עם ירקות, וונטון קריספי, כדורי בשר ובחירה של עוף, חזיר או טופו.", "Fideos en caldo claro con verduras, wonton crujiente, albóndigas y elección de pollo, cerdo o tofu.", "맑은 육수의 국수로 야채, 바삭한 완탕, 미트볼이 들어있으며 치킨, 돼지고기, 두부 중 선택 가능합니다.", "澄んだスープの麺料理。野菜、揚げワンタン、肉団子入り。鶏・豚・豆腐からお選びいただけます。", "Nouilles dans un bouillon clair avec légumes, wonton croustillant, boulettes et choix de poulet, porc ou tofu.", "Tagliolini in brodo limpido con verdure, wonton croccante, polpette e scelta di pollo, maiale o tofu.", "Macarrão em caldo claro com legumes, wonton crocante, almôndegas e escolha de frango, porco ou tofu.", "Hủ tiếu/Mì nước trong với rau, hoành thánh giòn, bò viên và lựa chọn gà, heo hoặc đậu hũ.", "सब्जियों, खस्ता वॉनटन, मीटबॉल और चिकन, पोर्क या टोफू की पसंद के साथ साफ शोरबा में नूडल्स।", "نودلز في مرق صافٍ مع خضروات، ونطون مقرمش، كرات لحم، واختيارك من الدجاج أو اللحم أو التوفو." ], "price": 80, "category": "food_menu,Soup", "type": "vegetarian", "add_on": "", "food": true, "ingredients": [ "Rice noodles", "Pork/Chicken broth", "Coriander", "Bean sprouts", "Morning glory", "Crispy wonton skin", "Meatballs", "Fried garlic", "Choice of protein" ] }, { "title": "Dry Noodles (Chicken/Pork/Tofu)", "description": [ "Dry noodles with vegetables, crispy wonton, choice of chicken, pork or tofu, and meatballs.", "ก๋วยเตี๋ยวแห้งคลุกเคล้าน้ำมันกระเทียมเจียว ใส่ผัก เกี๊ยวกรอบ ลูกชิ้น และเลือกโปรตีนได้ (ไก่/หมู/เต้าหู้) ค่ะ", "ဟင်းသီးဟင်းရွက်၊ ဝမ်တွန်းကြော်၊ အသားလုံးတို့ပါဝင်သော ခေါက်ဆွဲခြောက်။ ကြက်သား၊ ဝက်သား သို့မဟုတ် တိုဟူး ရွေးချယ်နိုင်သည်။", "Trockene Nudeln mit Gemüse, knusprigem Wonton, Fleischbällchen und wahlweise Hähnchen, Schwein oder Tofu.", "拌面配蔬菜、脆皮云吞、肉丸，可选鸡肉、猪肉或豆腐。", "Сухая лапша с овощами, хрустящим вонтоном, фрикадельками и выбором курицы, свинины или тофу.", "נודלס יבש עם ירקות, וונטון קריספי, כדורי בשר ובחירה של עוף, חזיר או טופו.", "Fideos secos con verduras, wonton crujiente, albóndigas y elección de pollo, cerdo o tofu.", "야채, 바삭한 완탕, 미트볼이 들어간 비빔국수입니다. 치킨, 돼지고기, 두부 중 선택 가능합니다.", "汁なし麺。野菜、揚げワンタン、肉団子入り。鶏・豚・豆腐からお選びいただけます。", "Nouilles sèches avec légumes, wonton croustillant, boulettes et choix de poulet, porc ou tofu.", "Tagliolini a secco con verdure, wonton croccante, polpette e scelta di pollo, maiale o tofu.", "Macarrão seco com legumes, wonton crocante, almôndegas e escolha de frango, porco ou tofu.", "Mì khô với rau, hoành thánh giòn, bò viên và lựa chọn gà, heo hoặc đậu hũ.", "सब्जियों, खस्ता वॉनटन, मीटबॉल और चिकन, पोर्क या टोफू की पसंद के साथ सूखे नूडल्स।", "نودلز جافة مع خضروات، ونطون مقرمش، كرات لحم، واختيارك من الدجاج أو اللحم أو التوفو." ], "price": 80, "category": "food_menu,Soup", "type": "vegetarian", "add_on": "", "food": true, "ingredients": [ "Rice noodles", "Garlic oil", "Sweet soy sauce", "Bean sprouts", "Meatballs", "Crispy wonton skin", "Choice of protein", "Crushed peanuts (optional)" ] }, { "title": "Classic Tom Yum Noodles", "description": [ "Noodles in tom yum broth with vegetables, choice of chicken/pork, crispy wonton, peanuts, and meatballs.", "ก๋วยเตี๋ยวต้มยำรสจัดจ้าน ใส่ผัก เลือกได้ทั้งหมูหรือไก่ พร้อมเกี๊ยวกรอบ ถั่วลิสงคั่ว และลูกชิ้นค่ะ", "ဟင်းသီးဟင်းရွက်၊ ကြက်/ဝက်၊ ဝမ်တွန်းကြော်၊ မြေပဲနှင့် အသားလုံးတို့ပါဝင်သော တွမ်ယမ်းခေါက်ဆွဲ။", "Nudeln in Tom Yum-Brühe mit Gemüse, Fleisch nach Wahl, knusprigem Wonton, Erdnüssen und Fleischbällchen.", "冬阴功汤面配蔬菜、可选鸡肉或猪肉、脆皮云吞、花生和肉丸。", "Лапша в бульоне Том-ям с овощами, выбором мяса, хрустящим вонтоном, арахисом и фрикадельками.", "נודלס במרק טום יאם עם ירקות, בחירה של עוף/חזיר, וונטון קריספי, בוטנים וכדורי בשר.", "Fideos en caldo tom yum con verduras, pollo o cerdo, wonton crujiente, cacahuetes y albóndigas.", "채소, 치킨/돼지고기, 바삭한 완탕, 땅콩, 미트볼이 들어간 매콤새콤한 똠양 국수입니다.", "野菜、鶏・豚から選べる具材、揚げワンタン、ピーナッツ、肉団子が入ったトムヤムヌードル。", "Nouilles au bouillon tom yum avec légumes, choix de poulet/porc, wonton croustillant, cacahuètes et boulettes.", "Tagliolini in brodo tom yum con verdure, scelta di pollo/maiale, wonton croccante, arachidi e polpette.", "Macarrão em caldo tom yum com legumes, escolha de frango/porco, wonton crocante, amendoim e almôndegas.", "Mì Tom Yum với rau, lựa chọn gà/heo, hoành thánh giòn, đậu phộng và thịt viên.", "सब्जियों, चिकन/पोर्क, खस्ता वॉनटन, मूंगฟली और मीटबॉल के साथ टॉम यम शोरबा में नूडल्स।", "نودلز في مرق توم يوم مع خضروات، دجاج أو لحم، ونطون مقرمش، فول سوداني وكرات لحم." ], "price": 80, "category": "food_menu,Soup", "type": "meat", "add_on": "", "food": true, "ingredients": [ "Rice noodles", "Lemongrass", "Kaffir lime leaves", "Galangal", "Lime juice", "Fish sauce", "Thai chili paste", "Crushed peanuts", "Choice of protein" ] }, { "title": "Clear Soup with Rice (Chicken/Pork/Tofu)", "description": [ "Clear soup with rice, vegetables, choice of chicken, pork or tofu, and meatballs.", "ข้าวต้มน้ำใสรสชาติละมุน ใส่ผัก เลือกได้ทั้งไก่ หมู หรือเต้าหู้ พร้อมลูกชิ้นเด้งๆ ค่ะ", "ဟင်းသီးဟင်းရွက်၊ အသားလုံးနှင့် ကြက်၊ ဝက် သို့မဟုတ် တိုဟူး ရွေးချယ်နိုင်သော ထမင်းဖြူဟင်းချိုကြည်။", "Klare Suppe mit Reis, Gemüse, Fleischbällchen und wahlweise Hähnchen, Schwein oder Tofu.", "清汤泡饭配蔬菜、肉丸，可选鸡肉、猪肉或豆腐。", "Прозрачный суп с рисом, овощами, фрикадельками и выбором курицы, свинины или тофу.", "מרק צח עם אורז, ירקות, כדורי בשר ובחירה של עוף, חזיר או טופו.", "Sopa clara con arroz, verduras, albóndigas y elección de pollo, cerdo o tofu.", "맑은 국물에 밥, 야채, 미트볼이 들어있으며 치킨, 돼지고기, 두부 중 선택 가능합니다.", "澄んだスープのご飯（雑炊風）。野菜、肉団子入り。鶏・豚・豆腐からお選びいただけます。", "Soupe claire avec riz, légumes, boulettes et choix de poulet, porc ou tofu.", "Zuppa limpida con riso, verdure, polpette e scelta di pollo, maiale o tofu.", "Sopa clara com arroz, legumes, almه‌degas e escolha de frango, porco ou tofu.", "Canh cơm nước trong với rau, bò viên và lựa chọn gà, heo hoặc đậu hũ.", "सब्जियों, मीटबॉल और चिकन, पोर्क या टोफू की पसंद के साथ चावल के साथ साफ सूप।", "حساء صافٍ مع أرز، خضروات، كرات لحم، واختيارك من الدجاج أو اللحم أو التوفو." ], "price": 100, "category": "food_menu,Soup", "type": "vegetarian", "add_on": "", "food": true, "ingredients": [ "Steamed jasmine rice", "Pork/Chicken broth", "Celery", "Fried garlic", "Meatballs", "Choice of protein" ] }, { "title": "Creamy Tom Yum Noodles (Chicken/Pork/Tofu)", "description": [ "Creamy tom yum noodles with choice of chicken/pork/tofu, vegetables, egg, and toppings.", "ก๋วยเตี๋ยวต้มยำน้ำข้นรสเข้มข้น ใส่ไข่และผัก เลือกได้ทั้งหมู ไก่ หรือเต้าหู้ พร้อมเครื่องแน่นๆ ค่ะ", "ဟင်းသီးဟင်းရွက်၊ ကြက်ဥနှင့် အသားများပါဝင်သော တွမ်ယမ်းနို့စိမ်းခေါက်ဆွဲ။ ကြက်၊ ဝက် သို့မဟုတ် တိုဟူး ရွေးချယ်နိုင်သည်။", "Cremige Tom Yum-Nudeln mit Fleisch nach Wahl, Gemüse, Ei und Toppings.", "奶香冬阴功面配可选鸡肉、猪肉或豆腐、蔬菜、鸡蛋和配料。", "Сливочная лапша Том-ям с выбором мяса/тофу, овощами, яйцом и топпингами.", "נודלס טום יאם קרמי עם בחירה של עוף/חזיר/טופו, ירקות, ביצה ותוספות.", "Fideos tom yum cremosos con pollo, cerdo o tofu, verduras, huevo y guarniciones.", "부드러운 크림 똠양 국수입니다. 치킨, 돼지고기, 두부 중 선택 가능하며 야채, 계란, 토핑이 포함됩니다.", "クリーミーなトムヤムヌードル。鶏・豚・豆腐から選べる具材、野菜、卵、トッピング入り。", "Nouilles tom yum crémeuses avec choix de poulet/porc/tofu, légumes, œuf et garnitures.", "Tagliolini tom yum cremosi con scelta di pollo/maiale/tofu, verdure, uovo e condimenti.", "Macarrão tom yum cremoso com escolha de frango/porco/tofu, legumes, ovo e acompanhamentos.", "Mì Tom Yum béo ngậy với lựa chọn gà/heo/đậu hũ, rau, trứng và các loại topping.", "सब्जियों, अंडे और टॉपिंग के साथ चिकन/पोर्क/टोफू की पसंद के साथ मलाईदार टॉम यम नूडल्स।", "نودلز توم يوم بالكريم مع اختيارك من الدجاج أو اللحم أو التوفو، خضروات، بيض وإضافات." ], "price": 90, "category": "food_menu,Noodle", "type": "vegetarian", "add_on": "", "food": true, "ingredients": [ "Rice noodles", "Evaporated milk", "Thai chili paste", "Lemongrass", "Galangal", "Lime", "Soft boiled egg", "Choice of protein" ] }, { "title": "Creamy Tom Yum Soup (Chicken/Tofu)", "description": [ "Creamy tom yum soup with vegetables, egg, choice of chicken or tofu, and toppings.", "ต้มยำน้ำข้นรสจัดจ้านถึงใจ ใส่ผัก ไข่ และเลือกใส่ไก่หรือเต้าหู้ได้ตามชอบค่ะ", "ဟင်းသီးဟင်းရွက်၊ ကြက်ဥနှင့် ကြက်သား သို့မဟုတ် တိုဟူးပါဝင်သော တွမ်ယမ်းနို့စိမ်းฮင်းချို။", "Cremige Tom Yum-Suppe mit Gemüse, Ei, wahlweise Hähnchen oder Tofu und Toppings.", "奶香冬阴功汤配蔬菜、鸡蛋、可选鸡肉或豆腐及配料。", "Сливочный суп Том-ям с овощами, яйцом, выбором курицы или тофу и топпингами.", "מרק טום יאם קרמי עם ירקות, ביצה, בחירה של עוף או טופו ותוספות.", "Sopa tom yum cremosa con verduras, huevo, elección de pollo o tofu y guarniciones.", "야채, 계란, 치킨 또는 두부, 토핑이 들어간 부드러운 크림 똠양 수프입니다.", "クリーミーなトムヤムスープ。野菜、卵、鶏または豆腐、トッピング入り。", "Soupe tom yum crémeuse avec légumes, œuf, choix de poulet ou tofu et garnitures.", "Zuppa tom yum cremosa con verdure, uovo, scelta di pollo o tofu e condimenti.", "Sopa tom yum cremosa com legumes, ovo, escolha de frango ou tofu e acompanhamentos.", "Canh Tom Yum béo ngậy với rau, trứng, lựa chọn gà hoặc đậu hũ và các loại topping.", "सब्जियों, अंडे और टॉपिंग के साथ चिकन या टोफू की पसंद के साथ मलाईदार टॉम यम सूप।", "حساء توم يوم بالكريم مع خضروات، بيض، اختيارك من الدجاج أو التوفو وإضافات." ], "price": 100, "category": "food_menu,Noodle", "type": "vegetarian", "add_on": "", "food": true, "ingredients": [ "Chicken/Pork broth", "Evaporated milk", "Chili paste", "Mushrooms", "Lemongrass", "Lime juice", "Choice of protein" ] }, { "title": "Creamy Tom Yum Noodles (Seafood)", "description": [ "Creamy tom yum noodles with shrimp, squid, and vegetables.", "ก๋วยเตี๋ยวต้มยำน้ำข้นทะเล ใส่กุ้งและปลาหมึกสดๆ พร้อมผัก รสชาติเข้มข้นถึงเครื่องค่ะ", "ပုစွန်၊ ကင်းမွန်နှင့် ဟင်းသီးဟင်းရွက်များပါဝင်သော ပင်လယ်စာတွမ်ယမ်းနို့စိမ်းခေါက်ဆွဲ။", "Cremige Tom Yum-Nudeln mit Garnelen, Tintenfisch und Gemüse.", "奶香冬阴功海鲜面配虾、鱿鱼和蔬菜。", "Сливочная лапша Том-ям с креветками, кальмарами и овощами.", "נודלס טום יאם קרמי עם שרימפס, קלמרי וירקות.", "Fideos tom yum cremosos con camarones, calamares y verduras.", "새우, 오징어, 야채가 들어간 부드러운 해산물 크림 똠양 국수입니다.", "海鮮クリーミーなトムヤムヌードル。海老、イカ、野菜入り。", "Nouilles tom yum crémeuses aux crevettes, calamar et légumes.", "Tagliolini tom yum cremosi con gamberi, calamari e verdure.", "Macarrão tom yum cremoso com camarão, lula e legumes.", "Mì Tom Yum hải sản béo ngậy với tôm, mực và rau.", "झींगा, विद्रूप और सब्जियों के साथ मलाईदार टॉम यम नूडल्स।", "نودلز توم يوم بالكريم مع الروبيان، الحبار والخضروات." ], "price": 120, "category": "food_menu,Noodle", "type": "seafood", "add_on": "", "food": true, "ingredients": [ "Rice noodles", "Shrimp", "Squid", "Evaporated milk", "Thai chili paste", "Lemongrass", "Lime", "Mushrooms" ] }, { "title": "Creamy Tom Yum Soup with Rice (Seafood)", "description": [ "Creamy tom yum soup with shrimp, squid, vegetables, served with rice.", "ต้มยำน้ำข้นทะเลรสแซ่บ ใส่กุ้งและปลาหมึก เสิร์ฟพร้อมข้าวสวยร้อนๆ ค่ะ", "ပုစွန်၊ ကင်းမွန်၊ ဟင်းသီးဟင်းရွက်များပါဝင်သော ပင်လယ်စာတွမ်ယမ်းနို့စိမ်းဟင်းချိုကို ထมင်းဖြူနှင့် တွဲဖက်ထားသည်။", "Cremige Tom Yum-Suppe mit Garnelen, Tintenfisch und Gemüse, serviert mit Reis.", "奶香冬阴功海鲜汤配虾、鱿鱼、蔬菜，附赠米饭。", "Сливочный суп Том-ям с креветками, кальмарами и овощами, подается с рисом.", "מרק טום יאם קרמי עם שרימפס, קלמרי וירקות, מוגש עם אורז.", "Sopa tom yum cremosa con camarones, calamares y verduras, servida con arroz.", "새우, 오징어, 야채가 들어간 부드러운 해산물 크림 똠양 수프와 밥이 함께 제공됩니다.", "海鮮クリーミーなトムヤムスープ。海老、イカ、野菜入り。ライス付き。", "Soupe tom yum crémeuse aux crevettes, calamar et légumes, servie avec du riz.", "Zuppa tom yum cremosa con gamberi, calamari e verdure, servita con riso.", "Sopa tom yum cremosa com camarão, lula e legumes, servida com arroz.", "Canh Tom Yum hải sản béo ngậy với tôm, mực, rau, dùng kèm cơm trắng.", "झींगा, विद्रूप और सब्जियों के साथ मलाईदार टॉम यम सूप, चावल के साथ परोसा जाता है।", "حساء توم يوم بالكريم مع الروبيان، الحبار والخضروات، يقدم مع الأرز." ], "price": 140, "category": "food_menu,Noodle", "type": "seafood", "add_on": "", "food": true, "ingredients": [ "Shrimp", "Squid", "Jasmine rice (side)", "Evaporated milk", "Tom yum herbs", "Lime juice", "Fish sauce" ] }, { "title": "Water", "description": [ "Chilled, pure mineral water to keep you refreshed.", "น้ำแร่ธรรมชาติแช่เย็นบริสุทธิ์ ดื่มแล้วสดชื่นกระปรี้กระเปร่าค่ะ", "လန်းဆန်းစေရန် အအေးခံထားသော သန့်စင်သည့် သတ္တုဓာတ်ပါရေ။", "Gekühltes, reines Mineralwasser für Ihre Erfrischung.", "冰镇纯净矿泉水，清爽解渴。", "Охлажденная чистая минеральная вода, чтобы освежиться.", "מים מינרליים צוננים וטהורים כדי לשמור על רעננות.", "Agua mineral pura y fría para mantenerte refrescado.", "상쾌함을 유지해주는 시원하고 순수한 미네랄 워터입니다.", "リフレッシュに最適な、冷たくて純粋なミネラルウォーター。", "Eau minérale pure et fraîche pour vous désaltérer.", "Acqua minerale pura e fresca per rinfrescarti.", "Água mineral pura e gelada para mantê-lo refrescado.", "Nước khoáng tinh khiết mát lạnh giúp bạn sảng khoái.", "आपको तरोताजा रखने के लिए ठंडा, शुद्ध खनिज जल।", "مياه معدنية نقية ومبردة لتبقيك منتعشاً." ], "price": 20, "category": "drink_menu,soft_drinks", "type": "vegan", "add_on": "", "food": false, "ingredients": [ "Mineral water", "Ice" ] }, { "title": "Soda Water", "description": [ "Crisp, bubbly, and incredibly refreshing carbonated water.", "น้ำโซดาซ่าถึงใจ ดื่มคลายร้อนได้ดีเยี่ยมเลยค่ะ", "ကြည်လင်ပြီး အေးမြလန်းဆန်းစေသော ဆိုဒါရေ။", "Prickelndes und unglaublich erfrischendes kohlensäurehaltiges Wasser.", "清爽爽口、气泡丰富的碳酸水。", "Бодрящая, газированная и невероятно освежающая вода.", "מים מוגזים קריספיים ומרעננים במיוחד.", "Agua con gas crujiente y muy refrescante.", "톡 쏘는 탄산으로 정말 상쾌한 탄산수입니다.", "キレのある泡立ちが心地よい、爽快な炭酸水。", "Eau pétillante et incroyablement rafraîchissante.", "Acqua gassata frizzante e incredibilmente rinfrescante.", "Água gaseificada crocante, borbulhante e incrivelmente refrescante.", "Nước soda sủi bọt, cực kỳ giải khát.", "कुरकुरा, चुलबुला और अविश्वसनीय रूप से ताज़ा कार्बोनेटेड पानी।", "مياه فوارة منعشة للغاية ومليئة بالفقاعات." ], "price": 30, "category": "drink_menu,soft_drinks", "type": "vegan", "add_on": "", "food": false, "ingredients": [ "Carbonated water", "Ice" ] }, { "title": "Coke (Original / Zero)", "description": [ "The classic icy-cold refreshment you know and love.", "โค้กเย็นฉ่ำ เครื่องดื่มคลาสสิกที่คุณชื่นชอบ มีให้เลือกทั้งสูตรดั้งเดิมและไม่มีน้ำตาลค่ะ", "သင်နှစ်သက်သော ဂန္ထဝင်အအေးဓာတ် အချိုရည်။", "Die klassische eiskalte Erfrischung, die Sie kennen und lieben.", "您熟悉且喜爱的经典冰凉清爽饮品。", "Классический ледяной освежающий напиток, который вы знаете и любиte.", "המרענן הקלאסי והקר שאתם מכירים ואוהבים.", "El clásico refresco helado que conoces y amas.", "당신이 알고 사랑하는 클래식하고 시원한 청량음료입니다.", "誰もが愛する、キンキンに冷えた定番の爽快感。", "Le rafraîchissement glacé classique que vous connaissez et aimez.", "Il classico rinfresco ghiacciato che conosci e ami.", "O refresco gelado clássico que você conhece e ama.", "Thức uống giải khát mát lạnh cổ điển mà bạn luôn yêu thích.", "क्लासिक बर्फीली ठंडी ताजगी जिसे आप जानते हैं और पसंद करते हैं।", "الانتعاش الكلاسيكي البارد الذي تعرفه وتحبه." ], "price": 30, "category": "drink_menu,soft_drinks", "type": "vegan", "add_on": "", "food": false, "ingredients": [ "Coca-Cola syrup", "Carbonated water", "Ice" ] }, { "title": "Fanta (Sprite / Orange)", "description": [ "Sweet, fizzy, and bursting with fruity bubbles.", "แฟนต้าและสไปรท์ หวานซ่าสดชื่นด้วยฟองอากาศและรสผลไม้ค่ะ", "အသီးအရသာနှင့် အေးမြလန်းဆန်းစေသော အချိုရည်။", "Süß, spritzig und voller fruchtiger Blasen.", "香甜可口，气泡丰富，充满水果风味。", "Сладкий, шипучий напиток с фруктовыми пузырьками.", "מתוק, תוסס ומלא בבועות פירותיות.", "Dulce, con gas y lleno de burbujas frutales.", "달콤하고 톡 쏘는 과일 향 가득한 탄산음료입니다.", "甘くてシュワシュワ、フルーツの香りはじける炭酸飲料。", "Sucré, pétillant et débordant de bulles fruitées.", "Dolce, frizzante e pieno di bollicine alla frutta.", "Doce, efervescente e cheio de bolhas frutadas.", "Ngọt ngào, sủi bọt và bùng nổ hương vị trái cây.", "मीठा, चुलबुला और फलों के बुलबुलों से भरपूर।", "حلو، فوار ومليء بفقاعات الفاكهة." ], "price": 30, "category": "drink_menu,soft_drinks", "type": "vegan", "add_on": "", "food": false, "ingredients": [ "Fanta/Sprite syrup", "Carbonated water", "Ice" ] }, { "title": "Lipton (Lemon / Peach)", "description": [ "A chilled, sun-kissed tea with a bright burst of citrus or sweet peach.", "ชาลิปตันแช่เย็น หอมกลิ่นชาพร้อมรสเลมอนเปรี้ยวซ่าหรือรสพีชหวานละมุนค่ะ", "သံပရာ သို့မဟုတ် မက်မွန်သီးအရသာဖြင့် အေးမြလန်းဆန်းစေသော လက်ဖက်ရည်။", "Ein gekühlter Tee mit einem hellen Hauch von Zitrus oder süßem Pfirsich.", "冰镇茶饮，带有明亮的柑橘或香甜桃子的风味。", "Охлажденный чай с ярким цитрусовым вкусом или вкусом сладкого персика.", "תה צונן עם נגיעה של פרי הדר או אפרסק מתוק.", "Un té helado con un toque de cítricos o melocotón dulce.", "상큼한 시트러스나 달콤한 복숭아 향이 어우러진 시원한 차입니다.", "柑橘の爽やかさ、または桃の甘さが広がる冷たいティー。", "Un thé glacé avec un éclat d'agrumes ou de pêche sucrée.", "Un tè freddo con un tocco di agrumi o pesca dolce.", "Um chá gelado com um toque brilhante de frutas cítricas ou pêssego doce.", "Trà lipton mát lạnh với vị chanh tươi mát hoặc vị đào ngọt ngào.", "साइट्रस या मीठे आड़ू के साथ एक ठंडा चाय।", "شاي مبرد بنكهة الحمضيات المشرقة أو الخوخ الحلو." ], "price": 30, "category": "drink_menu,soft_drinks", "type": "vegan", "add_on": "", "food": false, "ingredients": [ "Lipton tea extract", "Sugar/Sweetener", "Fruit flavoring", "Water", "Ice" ] }, { "title": "Chang", "description": [ "Thailand's iconic, crisp lager. Light and easy to drink.", "เบียร์ช้าง ลาเกอร์ยอดนิยมของไทย รสชาติเบา ดื่มง่าย สดชื่นค่ะ", "ထိုင်းနိုင်ငံ၏ နာမည်ကြီးဘီယာ။ သောက်ရလွယ်ကူပြီး လန်းဆန်းစေသည်။", "Thailands ikonisches, klares Lager. Leicht und süffig.", "泰国标志性的爽口拉格啤酒。口感轻盈，极易入口。", "Знаменитый тайский светлый лагер. Легкий и приятный на вкус.", "בירת לאגר אייקונית של תאילנד. קלילה וקלה לשתייה.", "La icónica y crujiente lager de Tailandia. Ligera y fácil de beber.", "태국의 상징적인 깔끔한 라거 맥주입니다. 가볍고 마시기 편합니다.", "タイを代表するキレのあるラガービール。軽やかで飲みやすい味わい。", "La bière blonde emblématique de Thaïlande. Légère et facile à boire.", "L'iconica lager croccante della Thailandia. Leggera e facile da bere.", "A lager icônica e refrescante da Tailândia. Leve e fácil de beber.", "Bia lager biểu tượng của Thái Lan. Vị nhẹ và rất dễ uống.", "थाईलैंड का प्रतिष्ठित, कुरकुरा लैगर। हल्का और पीने में आसान।", "لاجر تايلاندي أيقوني ومنعش. خفيف وسهل الشرب." ], "price": 60, "category": "drink_menu,Beer", "type": "alcohol", "add_on": "", "food": false, "ingredients": [ "Water", "Malted barley", "Hops", "Yeast", "Rice" ] }, { "title": "Leo", "description": [ "A smooth, full-flavored Thai favorite that pairs perfectly with spicy food.", "เบียร์ลีโอ รสชาตินุ่มละมุน เข้มข้น เข้ากันได้ดีกับอาหารรสจัดค่ะ", "စပ်သောအစားအစာများနှင့် အထူးလိုက်ဖက်သည့် နူးညံ့သော ထိုင်းဘီယာ။", "Ein sanftes, vollmundiges thailändisches Lieblingsbier, das perfekt zu scharfem Essen passt.", "口感顺滑、风味醇正的泰国最爱啤酒，是辛辣食物的完美搭档。", "Мягкое и насыщенное тайское пиво, которое идеально сочетается с острой пищей.", "בירה תאילנדית אהובה בעלת טעם מלא וחלק, שמשתלבת מצוין עם אוכל חריף.", "Una favorita tailandesa suave y con mucho sabor que combina perfectamente con comida picante.", "부드럽고 풍부한 맛으로 매운 음식과 완벽하게 어울리는 태국 인기 맥주입니다.", "なめらかでコクのあるタイの人気ビール。辛い料理との相性が抜群です。", "Une bière thaïlandaise douce et savoureuse qui se marie parfaitement avec les plats épicés.", "Una birra tailandese morbida e saporita che si abbina perfettamente ai cibi piccanti.", "Uma favorita tailandesa suave e saborosa que combina perfeitamente com comida picante.", "Dòng bia êm ái, đậm đà của Thái Lan, cực kỳ hợp khi dùng chung với đồ cay.", "एक चिकना, पूर्ण-स्वाद वाला थाई पसंदीदा जो मसालेदार भोजन के साथ पूरी तरह से मेल खाता है।", "بيرة تايلاندية مفضلة ناعمة وغنية بالنكهة، تتناسب تماماً مع الطعام الحار." ], "price": 60, "category": "drink_menu,Beer", "type": "alcohol", "add_on": "", "food": false, "ingredients": [ "Water", "Malted barley", "Hops", "Yeast", "Rice" ] }, { "title": "Singha", "description": [ "The premium taste of Thailand. A rich, golden lager with a clean finish.", "เบียร์สิงห์ รสชาติระดับพรีเมียมของไทย ลาเกอร์สีทองเข้มข้นพร้อมรสสัมผัสที่สะอาดดื่มง่ายค่ะ", "ထိုင်းနိုင်ငံ၏ အဆင့်မြင့်အရသာ။ ရွှေရောင်တောက်ပပြီး အရသာကောင်းมွန်သည့် ဘီယာ။", "Der Premium-Geschmack Thailands. Ein reichhaltiges, goldenes Lager mit einem sauberen Abgang.", "泰国的优质口感。浓郁的金黄色拉格啤酒，余味纯净。", "Премиальный вкус Таиланда. Насыщенный золотистый лагер с чистым послевкусием.", "טעם הפרימיום של תאילנד. לאגר זהובה ועשירה עם סיומת נקייה.", "El sabor premium de Tailandia. Una lager dorada y rica con un final limpio.", "태국의 프리미엄 맛. 깔끔한 끝맛을 자랑하는 풍부한 황금빛 라거입니다.", "タイのプレミアムな味わい。コクのある黄金色のラガーで、すっきりとした後味。", "Le goût premium de la Thaïlande. Une lager dorée et riche avec une fin de bouche nette.", "Il gusto premium della Thailandia. Una lager dorata e ricca con un finale pulito.", "O sabor premium da Tailândia. Uma lager dourada e rica com um final limpo.", "Hương vị cao cấp của Thái Lan. Bia lager vàng óng, đậm đà với hậu vị thanh khiết.", "थाईलैंड का प्रीमियम स्वाद। एक समृद्ध, सुनहरा लैगर जिसका अंत साफ होता है।", "المذاق الفاخر لتايلاند. لاجر ذهبي غني مع خاتمة نظيفة." ], "price": 70, "category": "drink_menu,Beer", "type": "alcohol", "add_on": "", "food": false, "ingredients": [ "Water", "100% Barley malt", "Hops", "Yeast" ] }, { "title": "Mango Juice", "description": [ "Liquid sunshine. Made from 100% fresh, honey-sweet Thai mangoes.", "น้ำมะม่วงสดแท้ 100% หวานหอมเหมือนดื่มแสงแดดจากสวนมะม่วงไทยเลยค่ะ", "၁၀၀ ရာခိုင်နှုန်း လတ်ဆတ်သော ထိုင်းမန်ကျည်းသီးဖြင့် ပြုလုပ်ထားသည့် အချိုရည်။", "Flüssiger Sonnenschein. Hergestellt aus 100% frischen, honigsüßen thailändischen Mangos.", "液态阳光。由 100% 新鲜、如蜂蜜般甜美的泰国芒果制成。", "Жидкое солнце. Сделано из 100% свежих, сладких, как мед, тайских манго.", "קרן שמש נוזלית. עשוי מ-100% מנגו תאילנדי טרי ומתוק כדבש.", "Sol líquido. Hecho de mangos tailandeses 100% frescos y dulces como la miel.", "마치 액체로 된 햇살 같습니다. 100% 신선하고 꿀처럼 달콤한 태국 망고로 만들었습니다.", "飲む太陽。タイ産の新鮮で蜂蜜のように甘いマンゴーを100%使用。", "Du soleil liquide. Fabriqué à partir de mangues thaïlandaises 100 % fraîches et sucrées comme le miel.", "Sole liquido. Prodotto con mango tailandese fresco al 100% e dolce come il miele.", "Sol líquido. Feito de mangas tailandesas 100% frescas e doces como mel.", "Nắng vàng lỏng. Được làm từ 100% xoài Thái tươi ngon, ngọt lịm như mật ong.", "तरल धूप। 100% ताजे, शहद जैसे मीठे थाई आमों से बनाया गया।", "أشعة الشمس السائلة. مصنوع من مانجو تايلاندي طازج وحلو كالعسل بنسبة 100%." ], "price": 70, "category": "drink_menu,juice", "type": "vegan", "add_on": "", "food": false, "ingredients": [ "Fresh mango", "Water", "Syrup (optional)", "Ice" ] }, { "title": "Strawberry Juice", "description": [ "Sweet, tart, and vibrantly fresh berry goodness in every sip.", "น้ำสตรอว์เบอร์รีสด รสชาติหวานอมเปรี้ยว สดชื่นด้วยรสเบอร์รี่แท้ในทุกคำค่ะ", "လတ်ဆတ်သော စတော်ဘယ်ရီသီး၏ အချိုအချဉ်အရသာ။", "Süß, herb und voller lebendiger Beerenfrische in jedem Schluck.", "每一口都充满了甜中带酸、活力四射的新鲜草莓滋味。", "Сладкая, терпкая и яркая свежесть ягод в каждом глотке.", "מתוק, חמצמץ ומרענן - טעם של תותים טריים בכל שלוק.", "Dulce, ácida y vibrantemente fresca bondad de bayas en cada sorbo.", "모든 모금에 달콤하고 상큼하며 활기찬 베리의 신선함이 담겨 있습니다.", "甘酸っぱくて、ベリーの鮮やかな新鮮さが一口ごとに広がります。", "Douceur de baies fraîche, sucrée et acidulée à chaque gorgée.", "Bontà di frutti di bosco dolce, aspra e vibrantemente fresca in ogni sorso.", "Doçura de bagas doce, ácida e vibrantemente fresca em cada gole.", "Vị dâu tây ngọt thanh, chua nhẹ và tươi mới trong từng ngụm.", "हर घूंट में मीठी, तीखी और जीवंत ताजी बेरी की अच्छाई।", "حلاوة التوت الطازجة، الحلوة والحامضة في كل رشفة." ], "price": 70, "category": "drink_menu,juice", "type": "vegan", "add_on": "", "food": false, "ingredients": [ "Fresh strawberries", "Water", "Syrup", "Ice" ] }, { "title": "Pineapple Juice", "description": [ "A tropical escape. Freshly pressed pineapple with a zesty, sweet finish.", "น้ำสับปะรดคั้นสด ให้ความรู้สึกเหมือนไปพักผ่อนบนเกาะเขตร้อน รสเปรี้ยวหวานลงตัวค่ะ", "လတ်ဆတ်သော နာနတ်သီးဖျော်ရည်။", "Eine tropische Auszeit. Frisch gepresste Ananas mit einem spritzigen, süßen Abgang.", "热带逃离。现榨菠萝汁，清爽香甜。", "Тропический побег. Свежевыжатый ананас с пикантным сладким послевкусием.", "בריחה טרופית. אננס סחוט טרי עם סיומת מתוקה ומרעננת.", "Una escapada tropical. Piña recién exprimida con un final dulce y cítrico.", "열대지방으로의 탈출. 상큼하고 달콤한 맛의 신선한 파인애플 주스입니다.", "トロピカルな休日。絞りたてのパイナップルが生み出す、爽やかで甘い後味。", "Une évasion tropicale. Ananas fraîchement pressé avec une fin de bouche vive et sucrée.", "Una fuga tropicale. Ananas appena spremuto con un finale dolce e frizzante.", "Uma fuga tropical. Abacaxi espremido na hora com um final doce e picante.", "Một chuyến du ngoạn nhiệt đới. Nước ép dứa tươi với hậu vị ngọt ngào, sảng khoái.", "एक उष्णकटिबंधीय पलायन। एक ज़ेस्टी, मीठे खत्म के साथ ताजा दबाया हुआ अनानास।", "هروب استوائي. أناناس معصور طازجاً مع خاتمة حلوة ومنعشة." ], "price": 70, "category": "drink_menu,juice", "type": "vegan", "add_on": "", "food": false, "ingredients": [ "Fresh pineapple", "Water", "Ice" ] }, { "title": "Lemon Juice", "description": [ "Zesty, bright, and freshly squeezed to wake up your taste buds.", "น้ำมะนาวคั้นสด รสเปรี้ยวจี๊ดจ๊าด ช่วยปลุกความสดชื่นให้ร่างกายได้ทันทีค่ะ", "လတ်ဆတ်သော သံပရာရည်။", "Spritzig, hell und frisch gepresst, um Ihre Geschmacksknospen zu wecken.", "清新明快，现榨柠檬汁，唤醒您的味蕾。", "Пикантный, яркий и свежевыжатый сок, чтобы пробудить ваши вкусовые рецепторы.", "מרענן, בהיר וסחוט טרי כדי להעיר את בלוטות הטעם שלכם.", "Cítrico, brillante y recién exprimido para despertar tus papilas gustativas.", "상큼하고 밝은 맛의 갓 짠 레몬 주스가 미각을 깨워줍니다.", "爽やかで鮮やか、絞りたてのレモンが味覚を呼び覚まします。", "Vif, éclatant et fraîchement pressé pour réveiller vos papilles.", "Frizzante, luminoso e appena spremuto per risvegliare le tue papille gustative.", "Picante, brilhante e espremido na hora para despertar o seu paladar.", "Vị chanh tươi mát, chua thanh giúp đánh thức mọi giác quan của bạn.", "अपने स्वाद कलियों को जगाने के लिए ज़ेस्टी, उज्ज्वल और ताजा निचोड़ा हुआ।", "منعش، مشرق ومعصور طازجاً ليوقظ حواس التذوق لديك." ], "price": 70, "category": "drink_menu,juice", "type": "vegan", "add_on": "", "food": false, "ingredients": [ "Fresh lemon", "Water", "Syrup", "Ice" ] }, { "title": "Orange Juice", "description": [ "100% pure squeezed oranges, naturally sweet and packed with Vitamin C.", "น้ำส้มคั้นสด 100% หวานธรรมชาติและอุดมด้วยวิตามินซีเต็มๆ คำค่ะ", "၁၀၀ ရာခိုင်နှုန်း လတ်ဆတ်သော လိမ္မော်ရည်။", "100% rein gepresste Orangen, natürlich süß und voller Vitamin C.", "100% 纯榨橙汁，天然甜润，富含维生素 C。", "100% свежевыжатые апельсины, натурально сладкие и полные витамина С.", "100% תפוזים סחוטים טהורים, מתוקים באופן טבעי ועמוסים בוויטמין C.", "Naranjas 100% puras exprimidas, naturalmente dulces y llenas de vitamina C.", "100% 순수 오렌지 착즙 주스로, 자연스러운 단맛과 비타민 C가 가득합니다.", "100%搾りたてのオレンジ。自然な甘みでビタミンCもたっぷり。", "Oranges 100 % pur jus, naturellement sucrées et pleines de vitamine C.", "Arance spremute al 100%, naturalmente dolci e ricche di vitamina C.", "Laranjas 100% puras espremidas, naturalmente doces e repletas de vitamina C.", "100% nước cam ép nguyên chất, ngọt tự nhiên và giàu Vitamin C.", "100% शुद्ध निचोड़ा हुआ संतरा, स्वाभाविक रूप से मीठा और विटामिन सी से भरपूर।", "عصير برتقال معصور 100%، حلو طبيعياً وغني بفيتامين سي." ], "price": 70, "category": "drink_menu,juice", "type": "vegan", "add_on": "", "food": false, "ingredients": [ "Fresh oranges", "Ice" ] }, { "title": "Banana Juice", "description": [ "Smooth, creamy, and naturally sweet. A unique tropical treat.", "น้ำกล้วยสด เนื้อเนียนนุ่ม หวานธรรมชาติ เป็นเครื่องดื่มเขตร้อนที่พิเศษสุดๆ ค่ะ", "လတ်ဆတ်သော ငှက်ပျောရည်။", "Sanft, cremig und natürlich süß. Ein einzigartiger tropischer Genuss.", "口感顺滑、软糯香甜。独特的热带美味。", "Гладкий, кремовый и натурально сладкий. Уникальное тропическое лакомство.", "חלק, קרמי ומתוק טבעי. פינוק טרופי ייחודי.", "Suave, cremoso y naturalmente dulce. Un regalo tropical único.", "부드럽고 크리미하며 자연스러운 단맛을 지닌 독특한 열대 음료입니다.", "なめらかでクリーミー、自然な甘さ。ユニークな南国の恵み。", "Onctueux, crémeux et naturellement sucré. Un délice tropical unique.", "Morbido, cremoso e naturalmente dolce. Un pezzo tropicale unico.", "Suave, cremoso e naturalmente doce. Um deleite tropical único.", "Hương vị chuối mềm mại, béo ngậy và ngọt tự nhiên. Một món quà nhiệt đới độc đáo.", "चिकना, मलाईदार और स्वाभाविक रूप से मीठा। एक अनूठा उष्णकटिबंधीय उपचार।", "ناعم، كريمي وحلو طبيعياً. تحلية استوائية فريدة." ], "price": 70, "category": "drink_menu,juice", "type": "vegan", "add_on": "", "food": false, "ingredients": [ "Fresh banana", "Water", "Ice" ] }, { "title": "Watermelon Juice", "description": [ "The ultimate hydrator. Pure, chilled watermelon juice for those hot Thai days.", "น้ำแตงโมสดปั่นเย็นฉ่ำ ช่วยคลายร้อนและเติมความสดชื่นได้ดีที่สุดในวันอากาศร้อนค่ะ", "ပူပြင်းသောနေ့များအတွက် အေးမြလန်းဆန်းသော ဖရဲသီးဖျော်ရည်စစ်စစ်။", "Der ultimative Durstlöscher. Reiner, gekühlter Wassermelonensaft für heiße Tage.", "终极补水饮品。纯净、冰镇的西瓜汁，适合炎热的天气。", "Лучший способ утолить жажду. Чистый охлажденный арбузный сок для жарких дней.", "המרענן האולטימטיבי. מיץ אבטיח טהור וצונן לימים החמים של תאילנד.", "El hidratante definitivo. Jugo de sandía puro y frío para esos días calurosos.", "최고의 수분 보충제. 더운 날씨에 딱 맞는 순수하고 시원한 수박 주스입니다.", "究極の水分補給。暑い日にぴったりの、冷たくてピュアなスイカジュース。", "L'hydratation ultime. Jus de pastèque pur et frais pour les journées chaudes.", "Il massimo dell'idratazione. Succo d'anguria puro e ghiacciato per le giornate calde.", "O hidratante definitivo. Suco de melancia puro e gelado para os dias quentes.", "Thức uống giải nhiệt tuyệt vời. Nước ép dưa hậu nguyên chất cho ngày hè nóng bức.", "परम हाइड्रेटर। उन गर्म दिनों के लिए शुद्ध, ठंडा तरबूज का रस।", "المرطب الأمثل. عصير بطيخ نقي ومبرد لتلك الأيام الحارة." ], "price": 70, "category": "drink_menu,juice", "type": "vegan", "add_on": "", "food": false, "ingredients": [ "Fresh watermelon", "Ice" ] }, { "title": "Apple Juice", "description": [ "Crisp, clean, and naturally sweet juice made from premium apples.", "น้ำแอปเปิ้ลคั้นสด รสชาติสะอาดสดชื่น หวานธรรมชาติจากแอปเปิ้ลคัดเกรดพรีเมียมค่ะ", "လတ်ဆတ်သော ပန်းသီးရည်။", "Frischer, klarer und natürlich süßer Saft aus hochwertigen Äpfeln.", "清脆、纯净，由优质苹果制成的天然甜味果汁。", "Свежий, чистый и натурально сладкий сок из яблок премиум-класса.", "מיץ פריך, נקי ומתוק טבעי העשוי מתפוחים משובחים.", "Jugo crujiente, limpio y naturalmente dulce hecho de manzanas premium.", "프리미엄 사과로 만든 깔끔하고 자연스러운 단맛의 주스입니다.", "厳選されたリンゴを使用した、すっきりとした自然な甘さのジュース。", "Un jus frais, pur et naturellement sucré à partir de pommes de qualité.", "Succo fresco, puro e naturalmente dolce fatto con mele premium.", "Suco crocante, limpo e naturalmente doce feito de maçãs premium.", "Nước ép táo tươi mát, vị ngọt thanh khiết từ những trái táo thượng hạng.", "प्रीमियम सेब से बना कुरकुरा, स्वच्छ और स्वाभाविक रूप से मीठा रस।", "عصير تفاح نقي وطبيعي الحلاوة مصنوع من أجود أنواع التفاح." ], "price": 70, "category": "drink_menu,juice", "type": "vegan", "add_on": "", "food": false, "ingredients": [ "Fresh apples", "Water", "Ice" ] }, { "title": "Passion Fruit Juice", "description": [ "Exotically tart and intensely aromatic. A bold tropical favorite.", "น้ำเสาวรสรสชาติเปรี้ยวจี๊ดจ๊าดและหอมฟุ้ง เครื่องดื่มเขตร้อนรสจัดจ้านที่ต้องลองค่ะ", "လတ်ဆတ်သော ပက်ရှင်ဖရုရည်။", "Exotisch herb und intensiv aromatisch. Ein kräftiger tropischer Favorit.", "充满异国情调的酸甜滋味，果香浓郁。大胆的热带宠儿。", "Экзотический терпкий и насыщенный аромат. Смелый тропический фаворит.", "חמצמץ אקזוטי וארומטי במיוחד. מועדף טרופי נועז.", "Exóticamente ácida e intensamente aromática. Una favorita tropical audaz.", "이국적인 상큼함과 강렬한 향. 대담한 열대 지방의 인기 음료입니다.", "エキゾチックな酸味と力強い香り。南国で大人気のボールドな味わい。", "Exotiquement acidulé et intensément aromatique. Un favori tropical audacieux.", "Esoticamente aspro e intensamente aromatico. Un audace favorito tropicale.", "Exoticamente ácido e intensamente aromático. Um favorito tropical ousado.", "Vị chanh dây chua thanh lạ miệng và hương thơm nồng nàn. Một món quà nhiệt đới đầy cuốn hút.", "विदेशी रूप से तीखा और तीव्रता से सुगंधित। एक बोल्ड उष्णकटिबंधीय पसंदीदा।", "حموضة غريبة وعطر كثيف. مشروب استوائي مفضل وقوي." ], "price": 70, "category": "drink_menu,juice", "type": "vegan", "add_on": "", "food": false, "ingredients": [ "Fresh passion fruit", "Water", "Syrup", "Ice" ] }, { "title": "Mixed Fruit Juice", "description": [ "A vibrant, healthy melody of the season’s best tropical fruits.", "น้ำผลไม้รวมที่ผสมผสานความสดชื่นและสุขภาพดีจากผลไม้เขตร้อนที่ดีที่สุดตามฤดูกาลค่ะ", "လတ်ဆတ်သော အသီးမျိုးစုံဖျော်ရည်။", "Eine lebendige, gesunde Melodie der besten tropischen Früchte der Saison.", "充满活力与健康的旋律，由当季最好的热带水果汇聚而成。", "Яркая, здоровая мелодия лучших тропических фруктов сезона.", "שילוב בריא ותוסס של מיטב הפירות הטרופיים של העונה.", "Una melodía vibrante y saludable de las mejores frutas tropicales de la temporada.", "제철 최고의 열대 과일들이 어우러진 활기차고 건강한 맛입니다.", "旬の南国フルーツを贅沢にブレンドした、鮮やかで健康的な味わい。", "Une mélodie vibrante et saine des meilleurs fruits tropicaux de la saison.", "Una melodia vibrante e salutare dei migliori frutti tropicali di stagione.", "Uma melodia vibrante e saudável das melhores frutas tropicais da estação.", "Sự kết hợp hoàn hảo và lành mạnh của những loại trái cây nhiệt đới tốt nhất theo mùa.", "सीजन के सर्वश्रेष्ठ उष्णकटिबंधीय फलों का एक जीवंत, स्वस्थ संगीत।", "مزيج حيوي وصحي من أفضل الفواكه الاستوائية الموسمية." ], "price": 80, "category": "drink_menu,juice", "type": "vegan", "add_on": "", "food": false, "ingredients": [ "Assorted seasonal fruits", "Water", "Ice" ] }, { "title": "Mango Smoothie", "description": [ "Thick, frosty, and incredibly creamy. Like a frozen tropical dream.", "มะม่วงปั่นเนื้อเนียนนุ่ม เย็นฉ่ำ รสชาติหวานหอมเหมือนฝันในเขตร้อนเลยค่ะ", "ပြစ်ပြစ်အေးအေးနှင့် အလွန်နူးညံ့သော အရသာ။", "Dickflüssig, frostig und unglaublich cremig. Wie ein gefrorener tropischer Traum.", "浓郁冰爽，口感丝滑。仿佛置身于冰冻的热带美梦中。", "Густой, морозный и невероятно сливочный. Словно замороженная тропическая мечта.", "סמיך, קפוא וקרמי להפליא. כמו חלום טרופי קפוא.", "Espeso, helado e increíblemente cremoso. Como un sueño tropical congelado.", "진하고 시원하며 놀라울 정도로 부드럽습니다. 얼어붙은 열대지방의 꿈과 같은 맛입니다.", "濃厚でクリーミー、ひんやりとした食感。まるで凍った南国の夢のような味わい。", "Épais, givré et incroyablement crémeux. Comme un rêve tropical glacé.", "Denso, ghiacciato e incredibilmente cremoso. Come un sogno tropicale gelato.", "Espesso, gelado e incrivelmente cremoso. Como um sonho tropical gelado.", "Sinh tố xoài đặc, mát lạnh và béo ngậy. Như một giấc mơ nhiệt đới giữa băng giá.", "गाढ़ा, बर्फीला और अविश्वसनीय रूप से मलाईदार। एक जमे हुए उष्णकटिबंधीय सपने की तरह।", "كثيف، مثلج وكريمي للغاية. كأنه حلم استوائي متجمد." ], "price": 80, "category": "drink_menu,smoothie", "type": "vegeterian", "add_on": "", "food": false, "ingredients": [ "Fresh mango", "Ice", "Syrup", "Milk/Yogurt base (optional)" ] }, { "title": "Strawberry Smoothie", "description": [ "A luscious, icy blend of fresh strawberries and pure indulgence.", "สตรอว์เบอร์รีปั่นเนื้อละเอียด หวานฉ่ำเย็นชื่นใจ เป็นรางวัลที่แสนหวานสำหรับคุณค่ะ", "လတ်ဆတ်သော စတော်ဘယ်ရီသီး ဖျော်ရည်။", "Eine köstliche, eisige Mischung aus frischen Erdbeeren und purem Genuss.", "冰爽鲜美的草莓混纺，纯粹的味觉享受。", "Восхитительная ледяная смесь свежей клубники и чистого наслаждения.", "תערובת קפואה ומענגת של תותים טריים והנאה צרופה.", "Una deliciosa mezcla helada de fresas frescas y puro placer.", "신선한 딸기로 만든 감미롭고 시원한 블렌드로 순수한 즐거움을 선사합니다.", "新鮮なイチゴを贅沢に使った、ひんやり甘美な贅沢スムージー。", "Un mélange onctueux et glacé de fraises fraîches et de pur plaisir.", "Una deliziosa miscela ghiacciata di fragole fresche e puro piacere.", "Uma mistura deliciosa e gelada de morangos frescos e puro prazer.", "Sự hòa quyện mát lạnh của dâu tây tươi, mang lại cảm giác ngọt ngào khó cưỡng.", "ताजी स्ट्रॉबेरी और शुद्ध भोग का एक सुस्वादु, बर्फीला मिश्रण।", "مزيج مثلج فاخر من الفراولة الطازجة والمتعة الخالصة." ], "price": 80, "category": "drink_menu,smoothie", "type": "vegan", "add_on": "", "food": false, "ingredients": [ "Fresh strawberries", "Ice", "Syrup" ] }, { "title": "Pineapple Smoothie", "description": [ "A frosty, tangy blend that tastes like a tropical vacation in a glass.", "สับปะรดปั่นรสเปรี้ยวหวาน รสสัมผัสเย็นสดชื่นเหมือนได้ไปพักร้อนที่ทะเลเลยค่ะ", "လတ်ဆတ်သော နာနတ်သီး ဖျော်ရည်။", "Eine frostige, spritzige Mischung, die wie ein tropischer Urlaub im Glas schmeckt.", "冰凉酸爽，每一口都像是在玻璃杯里的热带假日。", "Морозная, пикантная смесь со вкусом тропического отпуска в бокале.", "תערובת קפואה ומרעננת בטעם של חופשה טרופית בכוס אחת.", "Una mezcla helada y ácida que sabe a vacaciones tropicales en un vaso.", "상큼하고 시원한 맛이 마치 컵 속에 담긴 열대 휴가와 같습니다.", "ひんやり甘酸っぱいブレンド。グラスの中の南国リゾートをお楽しみください。", "Un mélange givré et acidulé qui a le goût de vacances tropicales dans un verre.", "Una miscela ghiacciata e frizzante che sa di vacanza tropicale in un bicchiere.", "Uma mistura gelada e picante que tem gosto de férias tropicais em um copo.", "Món sinh tố dứa mát lạnh, vị chua ngọt như một kỳ nghỉ nhiệt đới trong ly nước.", "एक बर्फीला, तीखा मिश्रण जिसका स्वाद गिलास में उष्णकटिबंधीय छुट्टी जैसा होता है।", "مزيج مثلج ومنعش طعمه يشبه عطلة استوائية في كوب." ], "price": 80, "category": "drink_menu,smoothie", "type": "vegan", "add_on": "", "food": false, "ingredients": [ "Fresh pineapple", "Ice", "Syrup" ] }, { "title": "Lemon Smoothie", "description": [ "Sweet, tart, and icy cold. The perfect balance of citrus and frost.", "มะนาวปั่นรสเปรี้ยวอมหวาน เย็นจี๊ดจับใจ เป็นความลงตัวของรสเลมอนและน้ำแข็งค่ะ", "လတ်ဆတ်သော သံပရာ ဖျော်รည်။", "Süß, herb und eiskalt. Die perfekte Balance zwischen Zitrus und Frost.", "酸甜冰冷。柑橘风味与冰爽口感的完美平衡。", "Сладкий, терпкий и ледяной. Идеальный баланс цитруса и холода.", "מתוק, חמצמץ וקר כקרח. האיזון המושלם בין הדרים לכפור.", "Dulce, ácido y helado. El equilibrio perfecto entre cítricos y frío.", "달콤하고 상큼하며 아주 시원합니다. 시트러스와 얼음의 완벽한 조화입니다.", "甘酸っぱくてキンキンに冷えた、シトラスと氷の完璧なバランス。", "Sucré, acidulé et glacial. L'équilibre parfait entre agrumes et fraîcheur.", "Dolce, aspro e gelido. Il perfetto equilibrio tra agrumi e ghiaccio.", "Doce, ácido e gelado. O equilíbrio perfeito entre citrinos e gelo.", "Sinh tố chanh chua ngọt mát lạnh. Sự cân bằng hoàn hảo giữa vị chua và đá xay.", "मीठा, तीखा और बर्फीला ठंडा। साइट्रस और पाले का सही संतुलन।", "حلو، حامض وبارد جداً. التوازن المثالي بين الحمضيات والثلج." ], "price": 80, "category": "drink_menu,smoothie", "type": "vegan", "add_on": "", "food": false, "ingredients": [ "Fresh lemon", "Ice", "Syrup" ] }, { "title": "Orange Smoothie", "description": [ "A refreshing frozen citrus treat made with 100% fresh orange juice.", "ส้มปั่นเกล็ดหิมะ ทำจากน้ำส้มคั้นสด 100% ดื่มแล้วสดชื่นมีชีวิตชีวาค่ะ", "၁၀၀ ရာခိုင်နှုန်း လတ်ဆတ်သော လိမ္မော် ဖျော်ရည်။", "Ein erfrischender gefrorener Zitrusgenuss aus 100% frischem Orangensaft.", "由 100% 新鲜橙汁制成的清爽冷冻柑橘美食。", "Освежающее замороженное цитрусовое лакомство из 100% свежего апельсинового сока.", "פינוק הדרים קפוא ומרענן העשוי מ-100% מיץ תפוזים טרי.", "Un refrescante manjar cítrico helado hecho con jugo de naranja 100% fresco.", "100% 신선한 오렌지 주스로 만든 상쾌한 과일 슬러시입니다.", "100%新鮮なオレンジジュースで作った、爽快なフローズンデザート。", "Un délice d'agrumes glacé et rafraîchissant fait de jus d'orange 100 % frais.", "Un rinfrescante dolcetto agli agrumi ghiacciato fatto con succo d'arancia fresco al 100%.", "Um deleite cítrico gelado refrescante feito com suco de laranja 100% fresco.", "Món sinh tố cam giải nhiệt được làm từ 100% nước cam ép tươi.", "100% ताजे संतरे के रस से बना एक स्फूर्तिदायक जमे हुए साइट्रस उपचार।", "تحلية حمضيات مثلجة ومنعشة مصنوعة من عصير برتقال طازج 100%." ], "price": 80, "category": "drink_menu,smoothie", "type": "vegan", "add_on": "", "food": false, "ingredients": [ "Fresh oranges", "Ice", "Syrup" ] }, { "title": "Banana Smoothie", "description": [ "Thick, rich, and naturally sweet. A classic creamy delight.", "กล้วยปั่นเนื้อเข้มข้น หวานธรรมชาติจากกล้วยสุก เป็นความอร่อยที่นุ่มนวลคลาสสิกค่ะ", "နူးညံ့သော ငှက်ပျော ဖျော်ရည်။", "Dickflüssig, reichhaltig und natürlich süß. Ein klassischer cremiger Genuss.", "浓郁醇厚，天然甜香。经典的丝滑美味。", "Густой, насыщенный и натурально сладкий. Классическое кремовое наслаждение.", "סמיך, עשיר ומתוק טבעי. תענוג קרמי קלאסי.", "Espeso, rico y naturalmente dulce. Un clásico deleite cremoso.", "진하고 풍부하며 자연스러운 단맛을 지닌 클래식하고 부드러운 즐거움입니다.", "濃厚でコクがあり、自然な甘さ。定番のクリーミーな美味しさ。", "Épais, riche et naturellement sucré. Un délice crémeux classique.", "Denso, ricco e naturalmente dolce. Una classica delizia cremosa.", "Espesso, rico e naturalmente doce. Um clássico deleite cremoso.", "Sinh tố chuối đặc, đậm đà và ngọt tự nhiên. Một món ngon kem mịn cổ điển.", "गाढ़ा, समृद्ध और स्वाभाविक रूप से मीठा। एक क्लासिक मलाईदार खुशी।", "كثيف، غني وحلو طبيعياً. لذة كريمية كلاسيكية." ], "price": 80, "category": "drink_menu,smoothie", "type": "vegeterian", "add_on": "", "food": false, "ingredients": [ "Fresh banana", "Milk/Yogurt base", "Ice", "Syrup" ] }, { "title": "Watermelon Smoothie", "description": [ "The frostiest way to cool down. Fresh watermelon blended with ice.", "แตงโมปั่นเกล็ดน้ำแข็ง วิธีคลายร้อนที่เย็นที่สุดด้วยแตงโมสดหวานฉ่ำค่ะ", "အေးမြသော ဖရဲသီး ဖျော်ရည်။", "Die frostigste Art, sich abzukühlen. Frische Wassermelone mit Eis gemixt.", "最冰凉的降温方式。新鲜西瓜与冰块的完美融合。", "Самый морозный способ охладиться. Свежий арбуз, смешанный со льдом.", "הדרך הקפואה ביותר להצטנן. אבטיח טרי מעורבב עם קרח.", "La forma más helada de refrescarse. Sandía fresca mezclada con hielo.", "가장 시원하게 열을 식히는 방법. 신선한 수박을 얼음과 함께 갈았습니다.", "最高にひんやりしたクールダウン。新鮮なスイカを氷と一緒にブレンド。", "La façon la plus givrée de se rafraîchir. Pastèque fraîche mixée avec de la glace.", "Il modo più gelato per rinfrescarsi. Anguria fresca frullata con ghiaccio.", "A maneira mais gelada de se refrescar. Melancia fresca batida com gelo.", "Cách giải nhiệt mát lạnh nhất. Dưa hấu tươi xay nhuyễn cùng đá.", "ठंडा होने का सबसे बर्फीला तरीका। बर्फ के साथ मिश्रित ताजा तरबूज।", "أكثر الطرق برودة للانتعاش. بطيخ طازج ممزوج بالثلج." ], "price": 80, "category": "drink_menu,smoothie", "type": "vegan", "add_on": "", "food": false, "ingredients": [ "Fresh watermelon", "Ice" ] }, { "title": "Apple Smoothie", "description": [ "Crisp apple flavor meets an icy-smooth texture for a refreshing boost.", "แอปเปิ้ลปั่นเนื้อเนียนละเอียด รสชาติสดชื่นช่วยเติมพลังให้ร่างกายได้ดีเยี่ยมค่ะ", "လတ်ဆတ်သော ပန်းသီး ဖျော်ရည်။", "Frischer Apfelgeschmack trifft auf eine eisig-glatte Textur für einen Erfrischungsschub.", "清爽的苹果风味与冰凉丝滑的口感相结合，焕发活力。", "Вкус свежего яблока в сочетании с ледяной текстурой для мощного освежающего эффекта.", "טעם תפוח פריך פוגש מרקם חלק וקפוא לחיזוק מרענן.", "El sabor de la manzana crujiente se une a una textura helada para un impulso refrescante.", "상큼한 사과 맛과 시원하고 부드러운 식감이 만나 기분 전환에 최고입니다.", "爽やかなリンゴの風味とひんやりスムースな食感。リフレッシュに最適。", "La saveur de la pomme croquante rencontre une texture glacée pour un élan de fraîcheur.", "Il sapore della mela fresca incontra una consisenza ghiacciata per una spinta rinfrescante.", "O sabor da maçã fresca encontra uma textura gelada para um impulso refrescante.", "Vị táo tươi giòn quyện cùng đá xay mịn màng giúp bạn nạp đầy năng lượng.", "ताज़ा बूस्ट के लिए कुरकुरा सेब का स्वाद एक बर्फीली-चिकनी बनावट से मिलता है।", "نكهة التفاح المنعشة تلتقي مع قوام مثلج ناعم لدفعة من الانتعاش." ], "price": 80, "category": "drink_menu,smoothie", "type": "vegan", "add_on": "", "food": false, "ingredients": [ "Fresh apples", "Ice", "Syrup" ] }, { "title": "Passion Fruit Smoothie", "description": [ "Tangy, bold, and icy. A tropical sensation for passion fruit lovers.", "เสาวรสปั่นรสจัดจ้านเปรี้ยวสะใจ สำหรับคนรักเสาวรสที่ต้องการความสดชื่นเขตร้อนค่ะ", "လတ်ဆတ်သော ပက်ရှင်ဖရု ဖျော်ရည်။", "Herb, kräftig und eisig. Eine tropische Sensation für Passionsfrucht-Liebhaber.", "酸爽大胆，冰凉透心。热带果香爱好者的感官盛宴。", "Терпкий, смелый и ледяной. Тропическая сенсация для любителей маракуйи.", "חמצמץ, נועז וקפוא. חוויה טרופית לחובבי פסיפלורה.", "Ácida, audaz y helada. Una sensación tropical para los amantes de la fruta de la pasión.", "상큼하고 강렬하며 시원합니다. 패션프루트 애호가를 위한 최고의 열대 음료입니다.", "酸味が効いた大胆な味わい。パッションフルーツ好きにはたまらない南国の刺激。", "Tangy, audacieux et glacé. Une sensation tropicale pour les amateurs de fruit de la passion.", "Aspro, audace e ghiacciato. Una sensazione tropicale per gli amanti del frutto della passione.", "Ácido, ousado e gelado. Uma sensação tropical para os amantes do maracujá.", "Sinh tố chanh dây chua đậm và mát lạnh. Một trải nghiệm nhiệt đới cho những ai yêu thích chanh dây.", "तीखा, बोल्ड और बर्फीला। जुनून फल प्रेमियों के लिए एक उष्णकटिबंधीय सनसनी।", "حامض، قوي ومثلج. إحساس استوائي لعشاق الباشن فروت." ], "price": 80, "category": "drink_menu,smoothie", "type": "vegan", "add_on": "", "food": false, "ingredients": [ "Fresh passion fruit", "Ice", "Syrup" ] }, { "title": "Mixed Fruit Smoothie", "description": [ "A luscious, frozen swirl of the best fruits nature has to offer.", "ผลไม้รวมปั่นเนื้อนุ่มละมุน รวมความอร่อยจากผลไม้ที่ดีที่สุดจากธรรมชาติไว้ในแก้วเดียวค่ะ", "လတ်ဆတ်သော အသီးမျိုးစုံ ဖျော်ရည်။", "Ein köstlicher, gefrorener Wirbel aus den besten Früchten, die die Natur zu bieten hat.", "大自然馈赠的多种精品水果，融合成冰凉丝滑的美妙旋律。", "Восхитительный ледяной вихрь из лучших фруктов, которые может предложить природа.", "מערבולת קפואה ונהדרת של מיטב הפירות שיש לטבע להציע.", "Un delicioso remolino helado de las mejores frutas que ofrece la naturaleza.", "자연이 선사하는 최고의 과일들이 어우러진 감미롭고 시원한 음료입니다.", "自然の恵み、厳選されたフルーツが織りなす甘美なフローズン・スワール。", "Un délicieux tourbillon glacé des meilleurs fruits que la nature peut offrir.", "Un delizioso vortice ghiacciato dei migliori frutti che la natura ha da offrire.", "Um redemoinho gelado e delicioso das melhores frutas que a natureza tem a oferecer.", "Sự kết hợp ngọt ngào của những loại trái cây tươi ngon nhất từ thiên nhiên.", "प्रकृति द्वारा पेश किए जाने वाले सर्वोत्तम फलों का एक सुस्वादु, जमा हुआ भंवर।", "دوامة مثلجة فاخرة من أفضل الفواكه التي تقدمها الطبيعة." ], "price": 90, "category": "drink_menu,smoothie", "type": "vegan", "add_on": "", "food": false, "ingredients": [ "Assorted seasonal fruits", "Ice", "Syrup" ] }, { "title": "Fresh Coconut", "description": [ "The purest taste of the islands. Chilled young coconut served whole and ready to drink.", "รสชาติบริสุทธิ์จากเกาะสวรรค์ มะพร้าวน้ำหอมแช่เย็นเสิร์ฟทั้งลูกพร้อมดื่มทันทีค่ะ", "ကျွန်းများ၏ စစ်မှန်သောအရသာ။ အေးမြသော အုန်းစိမ်းနုကို တစ်လုံးလုံး အဆင်သင့်သောက်သုံးနိုင်သည်။", "Der reinste Geschmack der Inseln. Gekühlte junge Kokosnuss, im Ganzen serviert.", "最纯净的海岛滋味。冰镇嫩椰子，整颗上桌，即刻享用。", "Чистый вкус островов. Охлажденный молодой кокос, подается целиком.", "הטעם הטהור של האיים. קוקוס צעיר וצונן המוגש שלם ומוכן לשתייה.", "El sabor más puro de las islas. Coco joven frío servido entero y listo para beber.", "섬의 가장 순수한 맛. 시원한 영 코코넛이 통째로 제공되어 바로 드실 수 있습니다.", "島の純粋な味わい。冷えた若いココナッツを丸ごと、すぐ飲める状態でご提供。", "Le goût pur des îles. Jeune noix de coco fraîche servie entière et prête à boire.", "Il gusto puro delle isole. Cocco giovane ghiacciato servito intero e pronto da bere.", "O sabor puro das ilhas. Coco jovem gelado servido inteiro e pronto para beber.", "Hương vị tinh khiết của đảo xanh. Dừa xiêm tươi mát lạnh phục vụ nguyên trái.", "द्वीपों का शुद्धतम स्वाद। ठंडा युवा नारियल पूरा परोसा गया और पीने के लिए तैयार।", "المذاق الأنقى للجزر. جوز هند فتي مبرد يقدم كاملاً وجاهز للشرب." ], "price": 100, "category": "drink_menu,smoothie", "type": "vegan", "add_on": "", "food": false, "ingredients": [ "Whole young coconut juice", "Coconut meat" ] } ], "add_on": [] }
